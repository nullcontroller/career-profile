+/* Editorial landing page */
+.landing-shell {
+  display: block;
+  max-width: 1060px;
+  margin: 0 auto;
+}
+.landing-shell > main {
+  max-width: 960px;
+  margin: 0 auto;
+  padding: 4.8rem 3rem 6rem;
+}
+.landing-hero {
+  max-width: 760px;
+  padding-bottom: 3.8rem;
+}
+.landing-hero h1 {
+  font-size: clamp(2.5rem, 6vw, 4.5rem);
+  margin: 0.5rem 0 0.7rem;
+}
+.landing-title {
+  font-size: clamp(1.6rem, 3vw, 2.35rem);
+  line-height: 1.4;
+  font-weight: 700;
+  margin: 0.3rem 0 1.25rem;
+}
+.landing-hero .lead {
+  max-width: 660px;
+  font-size: 1.2rem;
+}
+.landing-section {
+  border-top: 1px solid var(--line);
+  padding: 3.1rem 0;
+}
+.section-intro {
+  color: var(--muted);
+  max-width: 700px;
+}
+.start-grid,
+.path-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 1.2rem;
+}
+.start-entry {
+  display: block;
+  min-height: 260px;
+  padding: 1.4rem 1.35rem;
+  border: 1px solid var(--line);
+  background: var(--surface);
+  color: var(--ink);
+  text-decoration: none;
+  transition: border-color 120ms ease, transform 120ms ease;
+}
+.start-entry:hover,
+.start-entry:focus-visible {
+  border-color: var(--accent);
+  transform: translateY(-2px);
+}
+.start-entry h3 {
+  margin: 0.75rem 0 0.6rem;
+  font-size: 1.4rem;
+}
+.start-entry p {
+  color: var(--muted);
+  margin: 0 0 1.3rem;
+}
+.start-number,
+.path-grid > div > span {
+  color: var(--accent);
+  font-size: 0.82rem;
+  letter-spacing: 0.14em;
+  font-weight: 700;
+}
+.entry-cta {
+  color: var(--accent);
+  font-weight: 700;
+}
+.path-grid > div {
+  padding-right: 1rem;
+}
+.path-grid h3 {
+  margin: 0.5rem 0;
+}
+.path-grid p {
+  color: var(--muted);
+  margin-top: 0.35rem;
+}
+.featured-ideas ul {
+  columns: 2;
+  column-gap: 3rem;
+  margin: 0;
+}
+.featured-ideas li {
+  break-inside: avoid;
+  margin: 0.7rem 0;
+}
+.author-strip,
+.publications-strip {
+  max-width: 760px;
+}
+.publications-strip {
+  padding-bottom: 0;
+}
+@media (max-width: 760px) {
+  .landing-shell > main {
+    padding: 2.7rem 1.15rem 4rem;
+  }
+  .landing-hero {
+    padding-bottom: 2.5rem;
+  }
+  .landing-hero h1 {
+    font-size: 2.8rem;
+  }
+  .landing-hero .lead {
+    font-size: 1.08rem;
+  }
+  .start-grid,
+  .path-grid {
+    grid-template-columns: 1fr;
+    gap: 0.9rem;
+  }
+  .start-entry {
+    min-height: 0;
+  }
+  .featured-ideas ul {
+    columns: 1;
+  }
+}
+
