---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import ContentIndex from "../../components/ContentIndex.astro";
import { designTopics } from "../../lib/navigation";
import { publicEntry, url } from "../../lib/site";
const all = await getCollection("pages", publicEntry);
---

<Site
  title="AI設計"
  section="ai-design"
  ogImage="og/ai-design-foundations.png"
>
  <h1>AI設計</h1>
  <p class="lead">AIの性質を前提として、業務システムへどう組み込むか。</p>
  <p>
    適用判断から責任境界、評価、運用までを扱う現在の設計知識です。数学の章を先に読まなくても、必要なテーマから参照できます。
  </p>
  <section class="recommended-path" aria-labelledby="design-path-heading">
    <h2 id="design-path-heading">まず読む設計の流れ</h2>
    <p>AIをどこへ使うか、責任をどう分けるか、どう運用するかの順に読み進めます。</p>
    <ol class="reading-route">
      <li><a href={url("ai-design/applicability")}>AI適用判断</a> — 使う仕事と委任レベルを決める</li>
      <li><a href={url("ai-design/responsibility-control")}>責任境界・制御</a> — 生成・受理・実行を分ける</li>
      <li><a href={url("ai-design/architecture")}>Architecture</a> — 業務システム全体へ組み込む</li>
    </ol>
  </section>
  <nav class="topic-navigation" aria-label="AI設計のテーマ">
    {designTopics.map(([key, title]) => (
      <a href={url("ai-design/" + key)}>{title}</a>
    ))}
  </nav>
  {designTopics.map(([key, title, summary]) => (
    <section>
      <h2>
        <a href={url("ai-design/" + key)}>{title}</a>
      </h2>
      <p>{summary}</p>
      <ContentIndex
        entries={all.filter(
          (e) => e.data.layer === "ai-design" && e.data.design_topic === key,
        )}
      />
    </section>
  ))}
</Site>
